---
import Layout from './_Layout.astro';
// @ts-ignore
import 'open-props/easings';
---

<Layout steps={[]} heading="View Transitions in a Nut Shell">
	<div id="img">
		<div id="s1"></div>
		<div id="s2"></div>
		<div id="r2"></div>
		<div id="s3">🪴</div>
	</div>
	<div id="works">
		<h3>How it works</h3>
		<ul>
			<li>Takes some snapshots of areas from the old page</li>
			<li>Puts them in the view transition layer on top of the new page</li>
			<li>Puts some areas from the new page into the same layer</li>
			<li>Adds entry, exit, and shared element animations</li>
		</ul>
	</div>
</Layout>

<style is:global>
	ul {
		width: 33vw;
	}
	::view-transition-group(*) {
		animation-duration: 5s;
	}
	#slide-heading,
	#counter {
		view-transition-name: none !important;
	}
	#img {
		position: absolute;
	}
	#works {
		position: absolute;
		width: 45vw;
		transform: translate(-10vw, 0);
	}
	::view-transition-new(s3):only-child {
		animation-delay: 2s;
		animation-name: frame-new;
	}
	::view-transition-group(s3) {
		z-index: -1;
		animation-name: z;
		animation-delay: 1.6s;
	}

	@keyframes z {
		from {
			z-index: -1;
		}
		1% {
			z-index: 1;
		}
		to {
			z-index: 1;
		}
	}
	::view-transition-old(*) {
		animation-name: frame-old;
	}
	::view-transition-new(seedling),
	::view-transition-new(is) {
		display: none;
	}

	::view-transition-old(root) {
		animation-name: root-old;
		animation-timing-function: linear;
	}
	::view-transition-new(root) {
		animation-name: root-new;
		animation-delay: 2.5s;
	}

	@keyframes frame-old {
		to {
			outline: 3px solid #8a4c41;
			box-shadow: 0 0px 25px rgba(255, 255, 255, 0.4);
		}
	}
	@keyframes frame-new {
		from {
			transform: translate(-5vw, -18vw) scale(0.1);
		}
		25% {
			outline: 8px solid #8a4c41;
			box-shadow: 0 0px 25px rgba(255, 255, 255, 0.4);
		}
		50% {
			transform: translate(-5vw, -12vw) scale(0.1);
			outline: 3px solid #8a4c41;
			box-shadow: 0 0px 25px rgba(255, 255, 255, 0.4);
		}
		to {
			outline: 3px solid #8a4c41;
			box-shadow: 0 0px 25px rgba(255, 255, 255, 0.4);
			transform: scale(1) translate(0, 0);
		}
	}
	@keyframes root-old {
		from {
			outline: 4px solid gray;
			z-index: 1;
		}
		to {
			transform: translate(-33vw, -9vw) scale(0.3) rotate(-12deg);
			outline: 4px solid gray;
			box-shadow: 0 0px 25px rgba(255, 255, 255, 0.4);
			z-index: 0;
		}
	}

	@keyframes root-new {
		from {
			transform: translate(15vw, -13vw) scale(0.3) rotate(5deg);
			outline: 4px solid gray;
			box-shadow: 0 0px 25px rgba(255, 255, 255, 0.4);
			z-index: -1;
		}
		to {
			outline: 4px solid gray;
			z-index: 0;
		}
	}
	:root {
		view-transition-name: root;
	}
	img {
		position: absolute;
	}
	#s1 {
		position: absolute;
		view-transition-name: is;
		width: 15vw;
		aspect-ratio: 1.5/1;
		transform: translate(-45vw, 9vw) rotate(8deg);
	}
	#s2 {
		position: absolute;
		view-transition-name: seedling;
		width: 5vw;
		aspect-ratio: 1/1;
		transform: translate(-25vw, 10vw) rotate(-29deg);
	}
	#s3 {
		position: absolute;
		view-transition-name: s3;
		transform: translate(15vw, -15vw) rotate(8deg);
		font-size: 22vw;
	}
</style>
<script>
	let running = true;
		let t = 0;

	addEventListener('pointerdown', () => {
		document
			.getAnimations()
			.forEach((a) =>
				running ? ((t = a.currentTime as number), a.pause()) : ((a.currentTime = t), a.play())
			);
		running = !running;
	});
</script>
