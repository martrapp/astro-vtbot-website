---
import Layout from './_Layout.astro';
// @ts-ignore
import 'open-props/easings';
---

<Layout heading="Astro Bridged the Gap" steps={['magnifier', 'tree', 'work']}>
	<h3>Idea: Use client-side routing to emulate cross-document view transitions.</h3>
	<div id="seedling">🪴</div>
	<div id="magnifier">🔎</div>
	<div id="tree">🌳</div>
	<div id="work">
		<h2>Astro's view transition support</h2>
		<ul>
			<li>@matthewp · Astro 2.9 · under 150 lines</li>
			<li>Intercepts link clicks</li>
			<li>Fetches and parses the next document</li>
			<li>Starts a same-document view transition</li>
			<li>Swaps in the new document</li>
		</ul>
	</div>
</Layout>

<style is:global>
	h3 {
		position: absolute;
		transform: translateY(20vw);
		width: 75vw;
		display: none;
	}
	#work {
		padding-bottom: 8vw;
	}
	#seedling {
		font-size: 24vw;
		view-transition-name: s3;
		position: absolute;
		transform: translate(-30vw,-3vw);
	}
	#magnifier {
		display: none;
		font-size: 42vw;
		position: absolute;
		transform: translate(-4vw,3vw);
		view-transition-name: magnifier;
		transform: translateX(-33vw);
	}
	#tree {
		display: none;
		font-size: 18vw;
		position: absolute;
		view-transition-name: tree;
		transform: translate(-29vw,-3vw);
	}
	#work {
		display: none;
		view-transition-name: work;
		transform: translateX(18vw);
	}
	:root.magnifier {
		#magnifier {
			display: block;
		}
	}
	:root.tree {
		#tree {
			display: block;
		}
		h3 {
			display: block;
		}
	}
	:root.work {
		#work {
			display: block;
		}
	}
	::view-transition-group(s3) {
		animation-duration: 1s;
	}
</style>
