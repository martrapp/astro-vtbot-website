---
import Layout from './_Layout.astro';
import bot from 'astro-vtbot/assets/bag-of-tricks.svg';
import { Image } from 'astro:assets';
---

<Layout heading="About me" steps={6}>
	<ul>
		<li id="li1" style="view-transition-name: a1">
			<b>Martin</b><br />
			<small
				>View Transition enthusiast · Astro maintainer</small>
		</li>
		<li id="li2" style="view-transition-name: a2">I found Astro in 2023</li>
		<li id="li3" style="view-transition-name: a3">
			I helped build Astro's <code>ClientRouter</code>
		</li>
		<li id="li4" style="view-transition-name: a4">
			That took me deep into View Transitions
		</li>
		<li id="li5" style="view-transition-name: a5">
			I help people use them with <code>ClientRouter</code>&hellip;
		</li>
		<li id="li6" style="view-transition-name: a6">&hellip;and without it, on the web platform</li>
	</ul>
	<div id="icon">
		<div id="icon1">
			<Image id="img1" src={bot} alt="vtbot" width="200" height="200" />
			<div>astro-vtbot</div>
		</div>
		<div id="icon2">
			<img id="img2" src="/bag3.png" alt="vtbag.dev" />
			<div>vtbag.dev</div>
		</div>
	</div>
</Layout>
<style is:global>
	small {
		color: var(--text-muted);
		code {
			color: var(--accent-purple);
		}
	}
	#li1 {
		width: fit-content;
	}
	:root.li2 {
		small code {
			color: white;
		}
	}
	#icon1,
	#icon2 {
		display: none;
		filter: drop-shadow(0 0 0.75rem saddlebrown);
		flex-direction: column;
		align-items: center;
		font-size: 1.5vw;
		view-transition-name: icon1;
	}
	#icon2 {
		view-transition-name: icon2;
	}
	img {
		height: 15vw;
	}
	#img2 {
		transform: rotate(9deg)
	}
	#icon {
		display: flex;
		gap: 5vw;
	}
	:root.li5 {
		#icon1 {
			display: flex;
		}
	}
	:root.li6 {
		#icon2 {
			display: flex;
		}
	}
</style>
