---
import Layout from './_Layout.astro';
---

<Layout heading="About me" steps={5}>
	<ul>
		<li id="li0" style="view-transition-name: a1">
			<b>Martin</b><br />
			<small
				>View Transition enthusiast · Astro maintainer<br />
				GitHub <code>martrapp</code> · Bluesky <code>@martr.app</code></small
			>
		</li>
		<li id="li1" style="view-transition-name: a2">Found Astro in 2023</li>
		<li id="li2" style="view-transition-name: a3">
			Helped with <code>ClientRouter</code> implementation
		</li>
		<li id="li3" style="view-transition-name: a4">
			Happy to give view transition support on Discord
		</li>
		<li id="li4" style="view-transition-name: a5">Maker of Bags of Tricks for view transitions</li>
	</ul>
	<div id="icon">
		<div id="icon1">
			<img id="img1" src="/bot1.png" alt="vtbot" />
			<div>astro-vtbot</div>
		</div>
		<div id="icon2">
			<img id="img2" src="/bag3.png" alt="vtbag.dev" />
			<div>vtbag.dev</div>
		</div>
	</div>
</Layout>
<style is:global>
	small {
		color: var(--text-muted);
		code {
			color: var(--accent-purple);
		}
	}
	:root.li3 {
		small code {
			color: white;
		}
	}
	#icon1,
	#icon2 {
		display: none;
		filter: drop-shadow(0 0 0.75rem saddlebrown);
		flex-direction: column;
		align-items: center;
		font-size: 1.5vw;
		view-transition-name: icon1;
	}
	#icon2 {
		view-transition-name: icon2;
	}
	#img1,
	#img2 {
		height: 25vh;
	}
	#icon {
		display: flex;
		gap: 5vw;
	}
	:root.li4 {
		#icon1 {
			display: flex;
		}
	}
	:root.li5 {
		#icon2 {
			display: flex;
		}
	}
</style>
