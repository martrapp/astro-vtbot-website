---
import Layout from './_Layout.astro';
// @ts-ignore
import 'open-props/easings';
---

<Layout steps={['should', 'is', 'seedling', 'end']}>
	<div slot="heading">View transitions in 2023:<br />The Platform Wasn't Ready</div>
	<div id="tree">🌳</div>
	<div id="should">
		<h3>What we wanted</h3>
		<ul>
			<li>Smooth cross-document transitions when navigating multi-page apps</li>
			<li>No flash of white during navigation</li>
			<li>A naive browser feature, without a heavy framework</li>
		</ul>
	</div>
	<div id="is">
		<h3>What we had</h3>
		<ul>
			<li>Chromium only</li>
			<li>Behind an experimental flag</li>
			<li>Same-document transitions only</li>
		</ul>
	</div>
	<div id="seedling">🪴</div>
</Layout>

<style is:global>
	:root {
		view-transition-name: root;
	}
	::view-transition-group(root) {
		z-index: -1;
	}

	#tree {
		font-size: 40vw;
		position: absolute;
		width: 20vw;
		view-transition-name: tree;
		transform: translate(-18vw,0);
		
	}
	#should {
		display: none;
		position: absolute;
		width: 40vw;
		view-transition-name: should;
	}
	#is {
		display: none;
		width: 30vw;
		position: absolute;
		view-transition-name: is;
	}
	#seedling {
		display: none;
		font-size: 24vw;
		view-transition-name: seedling;
		position: absolute;
	}
	:root.should {
		#tree {
			transform: translate(-48vw,0);
		}
		#should {
			display: block;
			transform: translate(20vw, 0);
		}
	}
	:root.is {
		#should {
			transform: translate(-10vw, 0);
		}
		#is {
			display: block;
			transform: translate(30vw, 0);
		}
		#tree {
			transform: translate(-70vw, 0);
		}
	}
	:root.seedling {
		#tree {
			transform: translate(-100vw, 0);
		}
		#should {
			transform: translate(-27vw, 0);
		}
		#is {
			transform: translate(13vw, 0);
		}
		#seedling {
			display: block;
			transform: translate(39vw, -2vw);
		}
	}
	:root.end {
		background-color: var(--bg-space);
		#seedling {
			font-size: 9vw;
			transform: translate(39vw, 5vw);
			background-color: var(--bg-space);
		}
		#is {
			background-color: var(--bg-space);
		}
		#slide-header, #counter, #tree, #should {
			view-transition-name: none;
		}
		&::view-transition-old(should),
		&::view-transition-new(should) {
			animation-name: none;
		}
		#slide-heading, #counter {
			view-transition-name: none;
		}
	}
	::view-transition-group(seedling) {
		animation-timing-function: var(--ease-spring-3);
		animation-duration: 1s;
	}
	::view-transition-old(seedling) {
		width: auto;
		height: 100%;
	}
</style>
