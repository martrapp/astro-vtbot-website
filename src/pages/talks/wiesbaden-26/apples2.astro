---
import Layout from './_Layout.astro';
// @ts-ignore
import 'open-props/easings';
---

<Layout heading="Every Abstraction has a Cost" steps={['growing-green']}>
	<div id="img">
		<div id="tree">🌳</div>
		<div class="red-apple" id="a1">🍎</div>
		<div class="red-apple" id="a2">🍎</div>
		<div class="red-apple" id="a3">🍎</div>
		<div class="red-apple" id="a4">🍎</div>
		<div class="red-apple" id="a5">🍎</div>
		<div class="red-apple" id="a6">🍎</div>
		<div class="red-apple" id="a7">🍎</div>
		<!--div class="green-apple" id="a8">🍏</div-->
		<div class="green-apple" id="a9">🍏</div>
		<div class="green-apple" id="a10">🍏</div>
		<div class="lemon" id="a11">🍋</div>
	</div>
	<div id="features">
		<h2>Even a good abstraction adds complexity elsewhere</h2>
		<ul>
			<li class="green">Learn two layers:<br />Astro's abstraction and the underlying View Transition API</li>
			<li class="green">Handle navigation:<br /> Astro-specific events and lifecycle hooks</li>
			<li class="yellow">Adapt to SPA-like navigation:<br />re-initialize state and third-party scripts</li>
		</ul>
	</div>
</Layout>

<style is:global>
	.red-apple,
	.green-apple,
	.lemon {
		filter: drop-shadow(1px 0px 0px #4448) drop-shadow(-1px 0px 0px #4448)
			drop-shadow(0px 1px 0px #4448) drop-shadow(0px -1px 0px #4448);
	}

	h2 {
		view-transition-name: h2;
		width: fit-content;
	}
	#features {
		transform: translateX(15vw);
		width: 60vw;
	}
	ul {
		--icon: '🍎';
		scrollbar-width: thin;
		scrollbar-color: #7cb342 transparent;
		display: none;
	}
	li {
		position: relative;
		list-style: none;
		padding-left: 1vw;
		padding-right: 1.5vw;
		&::before {
			content: var(--icon);
			font-size: 1.7vw;
			position: absolute;
			transform: translate(-3vw, 0.25vw);
			filter: drop-shadow(1px 0px 0px #ccc8) drop-shadow(-1px 0px 0px #ccc8)
				drop-shadow(0px 1px 0px #ccc8) drop-shadow(0px -1px 0px #ccc8);
		}
	}
	li.green {
		--icon: '🍏';
	}
	li.yellow {
		--icon: '🍋';
	}
	#img {
		position: absolute;
		transform: translate(-19vw, -30vw);
	}

	#tree {
		font-size: 35vw;
		position: absolute;
		transform: translate(-37vw, 2vw);
	}

	.red-apple,
	.green-apple,
	.lemon {
		font-size: 4vw;
		position: absolute;
	}
	.green-apple,
	.lemon {
		display: none;
	}
	.green-apple {
		view-transition-class: green-apple;
	}
	.lemon {
		view-transition-class: lemon;
	}

	#a1 {
		transform: translate(-15vw, 12vw);
	}
	#a2 {
		transform: translate(-9vw, 19vw);
	}
	#a3 {
		transform: translate(-17vw, 25vw);
	}
	#a4 {
		transform: translate(-19vw, 18vw);
	}
	#a5 {
		transform: translate(-23vw, 24vw);
	}
	#a6 {
		transform: translate(-11vw, 27vw);
	}
	#a7 {
		transform: translate(-22vw, 30vw);
	}
	#a8 {
		view-transition-name: a8;
		transform: translate(-19vw, 28vw);
	}
	#a9 {
		view-transition-name: a9;
		transform: translate(-8vw, 31vw);
	}
	#a10 {
		view-transition-name: a10;
		transform: translate(-14vw, 17vw);
	}
	#a11 {
		view-transition-name: a11;
		transform: translate(-16vw, 33vw);
	}

	::view-transition-old(tree),
	::view-transition-new(tree) {
		animation-name: none;
	}
	:root.growing-green {
		ul,
		.green-apple,
		.lemon {
			display: block;
		}
		&::view-transition-new(a8) {
			animation-delay: 0s;
		}
		&::view-transition-new(a9) {
			animation-delay: 1s;
		}
		&::view-transition-new(a10) {
			animation-delay: 2s;
		}
		&::view-transition-new(a11) {
			animation-delay: 3s;
		}
	}

	::view-transition-group(.green-apple),
	::view-transition-group(.lemon) {
		animation-timing-function: var(--spring-easing);
		animation-duration: var(--spring-duration);
	}
</style>
