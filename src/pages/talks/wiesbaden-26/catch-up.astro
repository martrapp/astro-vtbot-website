---
import Layout from './_Layout.astro';
// @ts-ignore
import 'open-props/easings';
---

<Layout heading="The platform catches up" steps={7}>
	<div id="img">
		<div id="tree">🌳</div>
		<div class="red-apple" id="a1">🍎</div>
		<div class="red-apple" id="a2">🍎</div>
		<div class="red-apple" id="a3">🍎</div>
		<div class="red-apple" id="a4">🍎</div>
		<div class="red-apple" id="a5">🍎</div>
		<div class="red-apple" id="a6">🍎</div>
		<div class="red-apple" id="a7">🍎</div>
		<div class="green-apple" id="a8">🍏</div>
		<div class="green-apple" id="a9">🍏</div>
		<div class="green-apple" id="a10">🍏</div>
		<div class="lemon" id="a11">🍋</div>
		<div id="heading-a">Astro View Transitions</div>
	</div>
	<ul>
		<li id="li1">03 / 2023: Blink same-document</li>
		<li id="li2">06 / 2024: Blink cross-document</li>
		<li id="li3">09 / 2024: WebKit same-document</li>
		<li id="li4">12 / 2024: WebKit cross-document</li>
		<li id="li5">10 / 2025: Gecko same-document</li>
		<li id="li6">?? / 2026: Gecko cross-document</li>
	</ul>
	<div id="platform">
		<span id="t2">🌳</span>
		<span id="t1">🪴</span>
		<span id="t3">🌲</span>
		<div id="heading-b">The Web Platform</div>
	</div>
</Layout>

<style is:global>
	#heading-a {
		position: absolute;
		transform: translate(-22vw, 74vh);
		font-size: 6vh;
	}
	#heading-b {
		position: absolute;
		transform: translate(12.5vw, 74vh);
		font-size: 6vh;
		width: 20vw;
	}
	#img {
		position: absolute;
		transform: translate(-22vw, -48.5vh);
	}

	#tree {
		font-size: 60vh;
		position: absolute;
		transform: translate(-35vw, 0vh);
	}

	.red-apple,
	.green-apple,
	.lemon {
		font-size: 6vh;
		position: absolute;
	}
	.green-apple {
		view-transition-class: green-apple;
	}
	.lemon {
		view-transition-class: lemon;
	}

	#a1 {
		transform: translate(-15vw, 20vh);
	}
	#a2 {
		transform: translate(-9vw, 33vh);
	}
	#a3 {
		transform: translate(-17vw, 38vh);
	}
	#a4 {
		transform: translate(-19vw, 30vh);
	}
	#a5 {
		transform: translate(-23vw, 40vh);
	}
	#a6 {
		transform: translate(-11vw, 45vh);
	}
	#a7 {
		transform: translate(-22vw, 50vh);
	}
	#a8 {
		view-transition-name: a8;
		transform: translate(-19vw, 47vh);
	}
	#a9 {
		view-transition-name: a9;
		transform: translate(-8vw, 52vh);
	}
	#a10 {
		view-transition-name: a10;
		transform: translate(-14vw, 28vh);
	}
	#a11 {
		view-transition-name: a11;
		transform: translate(-16vw, 55vh);
	}

	.red-apple,
	.green-apple,
	.lemon {
		filter: drop-shadow(1px 0px 0px #4448) drop-shadow(-1px 0px 0px #4448)
			drop-shadow(0px 1px 0px #4448) drop-shadow(0px -1px 0px #4448);
	}
	li {
		view-transition-name: match-element;
	}
	#t3 {
		display: none;
	}
	:root.li7 {
		#t1,
		#t2 {
			display: none;
		}
		#t3 {
			display: block;
		}
	}
	h2 {
		view-transition-name: h2;
		width: fit-content;
	}
	ul {
		width: 40vw;
	}
	#platform {
		position: absolute;
		transform: translate(15vw, -49vh);
	}
	#astro,
	#t1,
	#t2,
	#t3 {
		position: absolute;
	}
	#astro {
		font-size: 60vh;
	}
	#t1 {
		font-size: 40vh;
		transform: translate(5vw, 25vh);
	}
	#t2 {
		font-size: 40vh;
		transform: translate(5vw, 20vh);
	}
	#t3 {
		font-size: 80vh;
		transform: translate(-9vw, -23.5vh);
	}
	#astro {
		view-transition-name: astro;
		transform: translate(-35vw, -5vh);
	}
	#t1 {
		view-transition-name: t1;
	}
	#t2 {
		view-transition-name: t2;
	}
	#t3 {
		view-transition-name: t3;
	}
	::view-transition-group(t1),
	::view-transition-group(t2),
	::view-transition-group(t3) {
		animation-timing-function: linear(0 0%, 0.0153 1.01%, 0.0372 1.77%, 0.0642 2.34%, 0.0947 2.79%, 0.1274 3.18%, 0.1607 3.56%, 0.1931 4%, 0.2232 4.57%, 0.2495 5.33%, 0.2705 6.33%, 0.2847 7.64%, 0.2906 9.33%, 0.2885 10.98%, 0.2803 12.21%, 0.2674 13.09%, 0.2508 13.72%, 0.2318 14.17%, 0.2117 14.53%, 0.1915 14.88%, 0.1725 15.3%, 0.156 15.88%, 0.143 16.69%, 0.1349 17.82%, 0.1328 19.36%, 0.1398 20.85%, 0.1569 21.83%, 0.182 22.41%, 0.2132 22.68%, 0.2484 22.74%, 0.2855 22.68%, 0.3226 22.59%, 0.3577 22.58%, 0.3886 22.73%, 0.4134 23.15%, 0.43 23.92%, 0.4365 25.15%, 0.4342 26.47%, 0.4268 27.51%, 0.4152 28.33%, 0.4003 29%, 0.3833 29.58%, 0.3651 30.13%, 0.3468 30.72%, 0.3292 31.4%, 0.3135 32.24%, 0.3006 33.3%, 0.2916 34.66%, 0.2874 36.36%, 0.2937 37.98%, 0.3134 39.14%, 0.3442 39.95%, 0.3833 40.52%, 0.4282 40.97%, 0.4763 41.39%, 0.5251 41.92%, 0.5719 42.66%, 0.6142 43.72%, 0.6493 45.22%, 0.6747 47.27%, 0.6879 49.98%, 0.6918 52.78%, 0.6919 55.05%, 0.6888 56.9%, 0.6832 58.39%, 0.6757 59.61%, 0.667 60.65%, 0.6578 61.59%, 0.6488 62.51%, 0.6406 63.5%, 0.6339 64.63%, 0.6294 66%, 0.6277 67.68%, 0.6327 69.5%, 0.6469 71.22%, 0.6686 72.87%, 0.6962 74.45%, 0.7282 75.98%, 0.763 77.45%, 0.799 78.89%, 0.8347 80.3%, 0.8684 81.7%, 0.8986 83.09%, 0.9237 84.49%, 0.9421 85.9%, 0.9554 87.36%, 0.9662 88.88%, 0.9749 90.42%, 0.9817 91.96%, 0.9869 93.45%, 0.9907 94.87%, 0.9935 96.18%, 0.9954 97.35%, 0.9967 98.36%, 0.9978 99.15%, 0.9988 99.71%, 1 100%);
		animation-duration: 0.9s;
	}
</style>
