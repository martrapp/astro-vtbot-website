---
import Layout from './_Layout.astro';
// @ts-ignore
import 'open-props/easings';
---

<Layout heading="With Rich Feature Set" steps={['growing-red']}>
	<div id="img">
		<div id="tree">🌳</div>
		<div class="red-apple" id="a1">🍎</div>
		<div class="red-apple" id="a2">🍎</div>
		<div class="red-apple" id="a3">🍎</div>
		<div class="red-apple" id="a4">🍎</div>
		<div class="red-apple" id="a5">🍎</div>
		<div class="red-apple" id="a6">🍎</div>
		<div class="red-apple" id="a7">🍎</div>
	</div>
	<div id="features">
		<h2>Astro's client router offers&hellip;</h2>
		<ul>
			<li>Cross-document view transitions for all browsers</li>
			<li>Automatically respects reduced motion preferences</li>
			<li>Automatic escaping of view transition names</li>
			<li>Predefined animations: fade & slide w/ parameters</li>
			<li>Forward/backward animations</li>
			<li>Persist DOM trees from old to new page&nbsp;&nbsp;</li>
			<li>Automatic prefetching and minimal render freeze</li>
		</ul>
	</div>
</Layout>

<style is:global>
	.red-apple {
		filter: drop-shadow(1px 0px 0px #4448) drop-shadow(-1px 0px 0px #4448) drop-shadow(0px 1px 0px #4448) drop-shadow(0px -1px 0px #4448);
	}
	h2 {
		view-transition-name: h2;
		width: fit-content;
	}
	#features {
		transform: translateX(15vw);
		width: 60vw;
	}
	ul {
		--icon: '🍎';
		scrollbar-width: thin;
		scrollbar-color: #7cb342 transparent;
		display: none;
	}
	li {
		position: relative;
		list-style: none;
		padding-left: 1vw;
		padding-right: 1.5vw;
		&::before {
			content: var(--icon);
			font-size: 1.7vw;
			position: absolute;
			transform: translate(-3vw, 0.25vw);
			filter: drop-shadow(1px 0px 0px #ccc8) drop-shadow(-1px 0px 0px #ccc8)
				drop-shadow(0px 1px 0px #ccc8) drop-shadow(0px -1px 0px #ccc8);
		}
	}
	#img {
		position: absolute;
		transform: translate(-19vw, -30vw);
	}
	#tree {
		font-size: 35vw;
		position: absolute;
		view-transition-name: tree;
		transform: translate(-37vw, 2vw);
	}

	.red-apple {
		font-size: 4vw;
		position: absolute;
		display: none;
	}
	.red-apple {
		view-transition-class: red-apple;
	}

	#a1 {
		view-transition-name: a1;
		transform: translate(-15vw, 12vw);
	}
	#a2 {
		view-transition-name: a2;
		transform: translate(-9vw, 19vw);
	}
	#a3 {
		view-transition-name: a3;
		transform: translate(-17vw, 25vw);
	}
	#a4 {
		view-transition-name: a4;
		transform: translate(-19vw, 18vw);
	}
	#a5 {
		view-transition-name: a5;
		transform: translate(-23vw, 24vw);
	}
	#a6 {
		view-transition-name: a6;
		transform: translate(-11vw, 27vw);
	}
	#a7 {
		view-transition-name: a7;
		transform: translate(-22vw, 30vw);
	}

	:root.growing-red {
		ul,
		.red-apple {
			display: block;
		}
		&::view-transition-new(tree) {
			animation-name: none;
		}
		&::view-transition-new(a1) {
			animation-delay: 0s;
		}
		&::view-transition-new(a2) {
			animation-delay: 1s;
		}
		&::view-transition-new(a3) {
			animation-delay: 2s;
		}
		&::view-transition-new(a4) {
			animation-delay: 3s;
		}
		&::view-transition-new(a5) {
			animation-delay: 4s;
		}
		&::view-transition-new(a6) {
			animation-delay: 5s;
		}
		&::view-transition-new(a7) {
			animation-delay: 6s;
		}
	}

	::view-transition-group(.red-apple) {
		animation-timing-function: var(--spring-easing);
		animation-duration: var(--spring-duration);
	}
</style>
