---
import Layout from './_Layout.astro';
// @ts-ignore
import 'open-props/easings';
---

<Layout heading="With Rich Feature Set" steps={7}>
	<div id="img">
		<div id="tree">🌳</div>
		<div class="red-apple" id="a1">🍎</div>
		<div class="red-apple" id="a2">🍎</div>
		<div class="red-apple" id="a3">🍎</div>
		<div class="red-apple" id="a4">🍎</div>
		<div class="red-apple" id="a5">🍎</div>
		<div class="red-apple" id="a6">🍎</div>
		<div class="red-apple" id="a7">🍎</div>
	</div>
	<div id="features">
		<h2>Astro's client router offers&hellip;</h2>
		<ul>
			<li id="li1">Cross-document view transitions for all browsers</li>
			<li id="li2">Automatically respects reduced motion preferences</li>
			<li id="li3">Automatic escaping of view transition names</li>
			<li id="li4">Predefined animations: fade & slide w/ parameters</li>
			<li id="li5">Forward/backward animations</li>
			<li id="li6">Persist DOM trees from old to new page&nbsp;&nbsp;</li>
			<li id="li7">Automatic prefetching and minimal render freeze</li>
		</ul>
	</div>
</Layout>

<style is:global>
	.red-apple {
		filter: drop-shadow(1px 0px 0px #4448) drop-shadow(-1px 0px 0px #4448)
			drop-shadow(0px 1px 0px #4448) drop-shadow(0px -1px 0px #4448);
	}
	h2 {
		view-transition-name: h2;
		width: fit-content;
	}
	#features {
		transform: translateX(15vw);
		width: 60vw;
	}
	ul {
		--icon: '🍎';
		scrollbar-width: thin;
		scrollbar-color: #7cb342 transparent;
	}
	li {
		position: relative;
		list-style: none;
		padding-left: 1vw;
		padding-right: 1.5vw;
		view-transition-name: match-element;
		&::before {
			content: var(--icon);
			font-size: 1.7vw;
			position: absolute;
			transform: translate(-3vw, 0.25vw);
			filter: drop-shadow(1px 0px 0px #ccc8) drop-shadow(-1px 0px 0px #ccc8)
				drop-shadow(0px 1px 0px #ccc8) drop-shadow(0px -1px 0px #ccc8);
		}
	}
	#img {
		position: absolute;
		transform: translate(-19vw, -30vw);
	}
	#tree {
		font-size: 35vw;
		position: absolute;
		view-transition-name: tree;
		transform: translate(-37vw, 2vw);
	}

	.red-apple {
		font-size: 4vw;
		position: absolute;
		display: none;
	}
	.red-apple {
		view-transition-class: red-apple;
	}

	#a1 {
		view-transition-name: a1;
		transform: translate(-15vw, 12vw);
	}
	#a2 {
		view-transition-name: a2;
		transform: translate(-9vw, 19vw);
	}
	#a3 {
		view-transition-name: a3;
		transform: translate(-17vw, 25vw);
	}
	#a4 {
		view-transition-name: a4;
		transform: translate(-19vw, 18vw);
	}
	#a5 {
		view-transition-name: a5;
		transform: translate(-23vw, 24vw);
	}
	#a6 {
		view-transition-name: a6;
		transform: translate(-11vw, 27vw);
	}
	#a7 {
		view-transition-name: a7;
		transform: translate(-22vw, 30vw);
	}

	:root.li1 {
		#a1 {
			display: block;
		}
		#tree {
			view-transition-name: none;
		}
		::view-transition-old(tree) {
			animation-name: none;
		}
	}
	:root.li2 {
		#a2 {
			display: block;
		}
	}
	:root.li3 {
		#a3 {
			display: block;
		}
	}
	:root.li4 {
		#a4 {
			display: block;
		}
	}
	:root.li5 {
		#a5 {
			display: block;
		}
	}
	:root.li6 {
		#a6 {
			display: block;
		}
	}
	:root.li7 {
		#a7 {
			display: block;
		}
	}


	::view-transition-group(.red-apple) {
		animation-timing-function: var(--spring-easing);
		animation-duration: var(--spring-duration);
	}
</style>
