---
import Layout from './_Layout.astro';
// @ts-ignore
import 'open-props/easings';
import { Code } from 'astro-expressive-code/components';
---

<Layout
	heading="How to Switch to the Platform"
	steps={['start', 'change', 'hide', 'flip', 'apple']}
>
	<div id="img">
		<div id="tree">🌳</div>
		<div class="red-apple" id="a1">🍎</div>
		<div class="red-apple" id="a2">🍎</div>
		<div class="red-apple" id="a3">🍎</div>
		<div class="red-apple" id="a4">🍎</div>
		<div class="red-apple" id="a5">🍎</div>
		<div class="red-apple" id="a6">🍎</div>
		<div class="red-apple" id="a7">🍎</div>
		<div class="green-apple" id="a9">🍏</div>
		<div class="green-apple" id="a10">🍏</div>
		<div class="lemon" id="a11">🍋</div>
	</div>

	<div id="question"><div>❓</div><div>==></div></div>
	<div id="cr">
		<Code
			title="Layout.astro"
			mark={['transition:animate="slide"', '<ClientRouter />', `transition:name="title"`]}
			code=`
<html lang="en" transition:animate="slide">
  <head>
    ...
    <ClientRouter />
    ...
  </head>
  <body>
    <h1 transition:name="title">...</h1>
    ...
	</body>
</html>`
			lang="astro"
		/>
	</div>
	<div id="api">
		<div id="slide"><code>transition:animate="slide"</code></div>
		<Code
			title="Layout.astro"
			mark={['@view-transition { navigation: auto; }', 'style="view-transition-name: title"']}
			code=`
<html lang="en">
	<head>
		...
		<style is:inline>
			@media (prefers-reduced-motion: no-preference) {
				@view-transition { navigation: auto; }
			}
		</style>
		...
	</head>
	<body>
	  <h1 style="view-transition-name: title">...</h1>
		...
	</body>
</html>`
			lang="astro"
		/>
	</div>
	<div id="css">
		<Code
			title="view-transition.css"
			mark={['@view-transition { navigation: auto; }', 'style="view-transition-name: title"']}
			code=`
::view-transition-old(root) {
	animation-name: slide-out;
}
::view-transition-new(root) {
	animation-name: slide-in;
}
@keyframes slide-out {
	to {
		transform: translateX(-100%);
	}
}
@keyframes slide-in {
	from {
		transform: translateX(100%);
	}
}`
			lang="css"
		/>
	</div>
	<div id="t3">
		<div>🎄</div>
		<div id="t3apple" class="red-apple">🍎</div>
		<div id="t4apple" class="green-apple">🍏</div>
	</div>
</Layout>

<style is:global>
	#slide {
		position: absolute;
		transform: translate(-15vw, 20vw) rotate(-90deg);
		view-transition-name: ec-html-mark;
		border-radius: 0.5ex;
		background-color: #174a9099;
		padding-bottom: 0.5ex;
	}
	:root.change {
		&::view-transition-group(ec-html-mark) {
			animation-duration: 1s;
			animation-delay: 0.5s;
		}
	}
	.gutter {
		padding-right: 0.5vw;
	}
	.code {
		padding-left: 1vw;
	}
	#img {
		position: absolute;
		transform: translate(-19vw, -32.2vw);
	}

	#tree {
		font-size: 35vw;
		position: absolute;
		transform: translate(-37vw, 2vw);
	}

	.red-apple,
	.green-apple,
	.lemon {
		font-size: 4vw;
		position: absolute;
	}
	#a1 {
		transform: translate(-15vw, 12vw);
	}
	#a2 {
		transform: translate(-9vw, 19vw);
	}
	#a3 {
		transform: translate(-17vw, 25vw);
	}
	#a4 {
		transform: translate(-19vw, 18vw);
	}
	#a5 {
		transform: translate(-23vw, 24vw);
	}
	#a6 {
		transform: translate(-11vw, 27vw);
	}
	#a7 {
		transform: translate(-22vw, 30vw);
	}
	#a8 {
		transform: translate(-19vw, 28vw);
	}
	#a9 {
		transform: translate(-8vw, 31vw);
	}
	#a10 {
		transform: translate(-14vw, 17vw);
	}
	#a11 {
		transform: translate(-16vw, 33vw);
	}

	.red-apple,
	.green-apple,
	.lemon {
		filter: drop-shadow(1px 0px 0px #4448) drop-shadow(-1px 0px 0px #4448)
			drop-shadow(0px 1px 0px #4448) drop-shadow(0px -1px 0px #4448);
	}

	#t3 {
		font-size: 40vw;
		transform: translate(35vw, -6vw);
		position: absolute;
		view-transition-name: t3;
	}
	#t3apple {
		font-size: 4vw;
		position: absolute;
		transform: translate(33vw, -16vw);
		view-transition-name: t3apple;
	}
	#t4apple {
		font-size: 4vw;
		position: absolute;
		transform: translate(25vw, -62vw);
		view-transition-name: t4apple;
		display: none;
	}

	#cr pre,
	#api pre,
	#css pre {
		view-transition-name: pre;
	}
	::view-transition-old(pre),
	::view-transition-new(pre) {
		width: 100%;
		height: auto;
		animation-name: shrink-out;
	}
	::view-transition-old(ec-activate-mark),
	::view-transition-new(ec-activate-mark),
	::view-transition-old(ec-h1-mark),
	::view-transition-new(ec-h1-mark) {
		height: 100%;
		width: auto;
		animation-name: shrink-out;
	}

	::view-transition-new(pre),
	::view-transition-new(ec-activate-mark),
	::view-transition-new(ec-h1-mark) {
		animation-name: grow-in;
	}
	#cr .ec-line:nth-of-type(1),
	#api .ec-line:nth-of-type(1) {
		view-transition-name: ec-html;
		mark {
			view-transition-name: ec-html-mark;
		}
	}
	#cr .ec-line:nth-of-type(2),
	#api .ec-line:nth-of-type(2) {
		view-transition-name: ec-head;
	}
	#cr .ec-line:nth-of-type(3),
	#api .ec-line:nth-of-type(3) {
		view-transition-name: ec-dots1;
	}
	#cr .ec-line:nth-of-type(4),
	#api .ec-line:nth-of-type(6) {
		view-transition-name: ec-activate;
		mark {
			view-transition-name: ec-activate-mark;
		}
	}
	#api .ec-line:nth-of-type(4),
	#api .ec-line:nth-of-type(5),
	#api .ec-line:nth-of-type(7),
	#api .ec-line:nth-of-type(8) {
		view-transition-name: match-element;
	}
	#cr .ec-line:nth-of-type(5),
	#api .ec-line:nth-of-type(9) {
		view-transition-name: ec-dots2;
	}
	#cr .ec-line:nth-of-type(6),
	#api .ec-line:nth-of-type(10) {
		view-transition-name: ec-head2;
	}
	#cr .ec-line:nth-of-type(7),
	#api .ec-line:nth-of-type(11) {
		view-transition-name: ec-body;
	}
	#cr .ec-line:nth-of-type(8),
	#api .ec-line:nth-of-type(12) {
		view-transition-name: ec-h1;
		mark {
			view-transition-name: ec-h1-mark;
		}
	}
	#cr .ec-line:nth-of-type(9),
	#api .ec-line:nth-of-type(13) {
		view-transition-name: ec-dots3;
	}
	#cr .ec-line:nth-of-type(10),
	#api .ec-line:nth-of-type(14) {
		view-transition-name: ec-body2;
	}
	#cr .ec-line:nth-of-type(11),
	#api .ec-line:nth-of-type(15) {
		view-transition-name: ec-html2;
	}
	h2 {
		view-transition-name: h2;
		width: fit-content;
	}

	#question {
		font-size: 20vw;
		position: absolute;
		view-transition-name: question;
		div {
			transform: translate(2vw, -6vw);
		}
		div:nth-of-type(1) {
			transform: translate(1vw, 5vw);
		}
	}
	#cr {
		z-index: 1;
	}
	#cr,
	#api,
	#css {
		display: none;
		transform: translateX(-10vw);
	}
	#cr {
		transform: translate(9vw, 0);
	}
	#cr,
	#api,
	#css {
		width: 50vw;
		code {
			font-size: 1.5vw;
			padding: 1ex;
		}
		.title {
			font-size: 1.5vw;
			line-height: 1.5;
			padding: 0.5ex 1ex;
			view-transition-name: title;
		}
		.expressive-code {
			view-transition-name: card;
		}
	}
	:root.start {
		#question {
			display: none;
		}
		#cr {
			display: block;
		}
	}
	:root.change {
		#cr {
			display: none;
		}
		#api {
			display: block;
		}
		#img {
			display: none;
		}
		#t3 {
			font-size: 40vw;
			transform: translate(35vw, -3vw);
		}
	}
	:root.hide {
		&,
		* {
			view-transition-name: none !important;
		}
		&::view-transition-group(*) {
			animation-duration: 0s;
		}
		.expressive-code {
			view-transition-name: card !important;
		}
	}
	:root.flip {
		#api {
			display: none;
		}
		#css {
			display: block;
		}
		&,
		* {
			view-transition-name: none !important;
		}
		.expressive-code {
			view-transition-name: card !important;
		}
		&::view-transition-image-pair(*) {
			perspective: 70cm;
		}
		&::view-transition-old(*) {
			animation-name: turn-out;
		}
		&::view-transition-new(*) {
			animation-name: turn-in;
		}
		&::view-transition-group(*) {
			animation-timing-function: ease-in-out;
			animation-duration: 0.5s;
		}
		#t4apple {
			view-transition-name: t4apple !important;
			display: block;
		}
	}
	@keyframes turn-out {
		0% {
			transform: rotateY(0deg);
			box-shadow: 0px 0px 10px var(--accent-purple);
		}
		50% {
			transform: rotateY(90deg);
			box-shadow: 0px 0px 150px var(--accent-purple);
			opacity: 1;
		}
		50.01% {
			opacity: 0;
			transform: rotateY(90deg);
		}
		100% {
			opacity: 0;
			transform: rotateY(90deg);
		}
	}
	@keyframes turn-in {
		0% {
			transform: rotateY(-90deg);
			opacity: 0;
		}
		49.99% {
			opacity: 0;
			transform: rotateY(-90deg);
		}
		50% {
			opacity: 1;
			transform: rotateY(-90deg);
			box-shadow: 0px 0px 150px var(--accent-purple);
		}

		100% {
			transform: rotateY(0deg);
			box-shadow: 0px 0px 10px var(--accent-purple);
		}
	}

	:root.apple {
		#t4apple {
			transform: translate(25vw, -19vw);
			view-transition-name: t4apple !important;
		}
		&::view-transition-group(t4apple) {
			animation-timing-function: var(--ease-spring-3);
			animation-duration: 1s;
		}
		&::view-transition-old(t4apple) {
			display: none;
		}
		&::view-transition-new(t4apple) {
			animation-name: none;
		}
		#css {
			display: none;
		}
	}
	:active-view-transition-type(cross-document) {
		&::view-transition-old(tree) {
			display: none;
		}
	}
</style>
