---
import Layout from './_Layout.astro';
---

<Layout slideNumber={1} steps={[]}>
	<span slot="heading"><span id="about">It's All About</span> <span id="trees">Trees</span></span>
	<div>
		<ul>
			<li>This is a test text</li>
			<li>And another one</li>
			<li>This is the longest of these three</li>
		</ul>
	</div>
</Layout>

<style is:global>
	#about {
		view-transition-name: about;
	}
	#trees {
		view-transition-name: trees;
	}
</style>

